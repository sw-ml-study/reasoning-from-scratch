#!/bin/sh
# Default acceptance requires real tokenizer data; fixture-only is an explicit, separately labeled check.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "${1:-}" in
    '') TOKENIZER_MODE=real ;;
    --fixture-only) TOKENIZER_MODE=fixture ;;
    *) echo 'usage: run-tokenizer-parity [--fixture-only]' >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || exit 2
TOKENIZER_PATH=${TOKENIZER_PATH:-"$repo/models/qwen3-0.6b-base/tokenizer.json"}
TOKENIZER_GOLDENS=${TOKENIZER_GOLDENS:-fixtures/tokenizer/qwen3-goldens.jsonl}
if [ "$TOKENIZER_MODE" = real ]; then
    case "$TOKENIZER_PATH" in /*) ;; *) echo 'TOKENIZER_PATH must be absolute' >&2; exit 2 ;; esac
    [ -f "$TOKENIZER_PATH" ] || { echo 'unavailable: real tokenizer missing; run just fetch-model' >&2; exit 77; }
    sha256sum "$TOKENIZER_PATH"
fi
export TOKENIZER_MODE TOKENIZER_PATH TOKENIZER_GOLDENS
exec "$repo/scripts/run-extension-demo" hftok demos/tokenizer_parity.mlpl
