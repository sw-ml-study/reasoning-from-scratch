#!/bin/sh
# Compare the MLPL reference tokenizer with the native hftok extension.
#
# Opt-in and gated on ../demo-extensions. Exits 77 with an explanation when
# the extension is not built, which is an honest "unavailable" result rather
# than a failure: the reference encoder remains the path for bounded slices.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
parent=$(CDPATH= cd -- "$repo_root/.." && pwd)
ext_repo="$parent/demo-extensions"
manifest="$ext_repo/extensions/hftok/extension.toml"

echo "Tokenizer parity: MLPL reference against the native hftok extension"

if [ ! -d "$ext_repo/extensions/hftok" ]; then
    echo "  unavailable: ../demo-extensions has no hftok extension yet" >&2
    echo "  work order:  docs/demo-extensions-requests.md, item E1" >&2
    exit 77
fi

if [ ! -f "$manifest" ]; then
    echo "  unavailable: hftok exists but has no extension.toml manifest yet" >&2
    echo "  present:     $(find "$ext_repo/extensions/hftok" -type f | sed "s|$ext_repo/||" | tr '\n' ' ')" >&2
    echo "  work order:  docs/demo-extensions-requests.md, item E1" >&2
    exit 77
fi

library=$(find "$ext_repo" -name 'lib*hftok*.dylib' -o -name 'lib*hftok*.so' 2>/dev/null | head -1 || true)
if [ -z "$library" ]; then
    echo "  unavailable: hftok is declared but no built library was found" >&2
    echo "  build it in ../demo-extensions, then rerun" >&2
    exit 77
fi

echo "  extension:   $library"
MLPL_EXTENSION_PATH=$(dirname "$library")
export MLPL_EXTENSION_PATH
exec "$repo_root/scripts/run-mlpl-demo" demos/tokenizer_parity.mlpl
