#!/bin/sh
# Opt-in device smoke. A numerically correct CPU fallback is unavailable (77).
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
mkdir -p "$repo_root/out/probes"
log="$repo_root/out/probes/cuda-matmul.log"
status=0
"$mlpl" --source-dir "$repo_root" "$repo_root/probes/cuda-matmul.mlpl" >"$log" 2>&1 || status=$?
cat "$log"
if grep -q 'falling back to CPU' "$log"; then
    echo 'unavailable: selected interpreter falls back to CPU; CUDA was not validated' >&2
    exit 77
fi
[ "$status" -eq 0 ] || exit "$status"
echo 'PASS CUDA matrix smoke; full Qwen3 dispatch and performance remain unmeasured'
