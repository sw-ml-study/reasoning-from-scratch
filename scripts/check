#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

sh -n "$repo_dir"/scripts/*
"$repo_dir/scripts/check-structure"
"$repo_dir/scripts/check-sources"
"$repo_dir/scripts/check-doc-links"
"$repo_dir/scripts/check-catalog"
"$repo_dir/scripts/check-mlpl-style"
"$repo_dir/scripts/check-tangle"
"$repo_dir/scripts/run-capability-probes"
"$repo_dir/scripts/run-tests"
"$repo_dir/scripts/run-verifier-demo" > /dev/null
"$repo_dir/scripts/run-generation-demo" > /dev/null
git -C "$repo_dir" diff --check

echo "PASS pre-commit"
