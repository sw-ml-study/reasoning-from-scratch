#!/bin/sh
# Opt-in pinned, checksum-verified Qwen tokenizer/config; add --weights for the 1.19 GB checkpoint.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "${1:-}" in ''|--weights) ;; *) echo 'usage: fetch-model [--weights]' >&2; exit 2 ;; esac
[ "$#" -le 1 ] || exit 2
"$repo/scripts/fetch-artifact" qwen-tokenizer
"$repo/scripts/fetch-artifact" qwen-config
if [ "${1:-}" = --weights ]; then "$repo/scripts/fetch-artifact" qwen-weights; fi
