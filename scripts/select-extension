#!/bin/sh
# Explicit absolute overrides win; otherwise select only the packaged platform artifact, never an arbitrary target/debug library.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
ext_root=${EXTENSIONS_ROOT:-"$repo/../demo-extensions"}
case "${1:-}" in
    hftok) override=${HFTOK_LIBRARY:-}; package=hftok; library=mlpl_extension_hftok ;;
    http) override=${HTTP_LIBRARY:-}; package=http-client; library=mlpl_extension_http_client ;;
    *) echo 'usage: select-extension hftok|http' >&2; exit 2 ;;
esac
if [ -n "$override" ]; then
    case "$override" in /*) ;; *) echo 'extension override must be absolute' >&2; exit 2 ;; esac
    [ -f "$override" ] || { echo "extension override missing: $override" >&2; exit 77; }
    printf '%s\n' "$override"
    exit 0
fi
case "$(uname -s):$(uname -m)" in
    Linux:x86_64) platform=x86_64-unknown-linux-gnu; suffix=so ;;
    Darwin:arm64) platform=aarch64-apple-darwin; suffix=dylib ;;
    *) echo 'unsupported platform: set an explicit extension library override' >&2; exit 77 ;;
esac
file="$ext_root/extensions/$package/native/$platform/lib$library.$suffix"
[ -f "$file" ] || { echo "packaged extension unavailable: $file" >&2; exit 77; }
dir=$(CDPATH= cd -- "$(dirname -- "$file")" && pwd)
printf '%s/%s\n' "$dir" "$(basename -- "$file")"
