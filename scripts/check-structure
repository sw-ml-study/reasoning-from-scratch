#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

for path in AGENTS.md COPYRIGHT LICENSE README.md justfile mlplunit.conf \
    catalog/components.toml \
    docs/architecture.md docs/book-map.md docs/data-and-models.md \
    docs/licensing.md docs/plan.md docs/sagas.md docs/sw-mlpl-blockers.md \
    docs/verifier-contract.md; do
    if [ ! -f "$repo_dir/$path" ]; then
        echo "missing required file: $path" >&2
        exit 1
    fi
done

peer="$repo_dir/../demo-mlpl-libraries"
if [ -d "$peer" ]; then
    cmp -s "$repo_dir/COPYRIGHT" "$peer/COPYRIGHT" || {
        echo "COPYRIGHT differs from peer repository" >&2
        exit 1
    }
    cmp -s "$repo_dir/LICENSE" "$peer/LICENSE" || {
        echo "LICENSE differs from peer repository" >&2
        exit 1
    }
fi

grep -q 'agentrail:global:start' "$repo_dir/AGENTS.md"
grep -q 'Distributed under the \[MIT License\](LICENSE)' "$repo_dir/README.md"
echo "structure: ok"
