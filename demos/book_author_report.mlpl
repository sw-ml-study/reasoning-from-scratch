# Offline MLPL report over public numeric book demonstration records; no model, downloaded questions or private outputs are needed.
include "lib/text/text.mlpl";
include "lib/eval/paired.mlpl";
include "lib/eval/book_report.mlpl";

def u:eval_report_decimal(value) {
  "Render one decimal place of precision for human-facing tables; full precision remains in JSON.";
  to_string(floor(value * 10 + 0.5) / 10)
}

def u:eval_report_row(cells) {
  "Render an Org table row from already formatted cells.";
  str_concat("| ", str_concat(str_join(cells, " | "), " |\n"))
}

def u:eval_report_accuracy_row(name, row) {
  "Render a method's measured denominator and descriptive Wilson interval.";
  count = str_join([to_string(row.correct), to_string(row.cases)], "/");
  accuracy = str_concat(u:eval_report_decimal(row.accuracy * 100), "%");
  interval = str_concat(str_join([u:eval_report_decimal(row.interval.lower * 100), u:eval_report_decimal(row.interval.upper * 100)], "–"), "%");
  u:eval_report_row([name, count, accuracy, interval])
}

def u:eval_report_cost_row(name, row) {
  "Render generation cost per call and across all calls, retaining truncation counts.";
  bounds = str_join([u:eval_report_decimal(row.min_call_ms / 1000), u:eval_report_decimal(row.max_call_ms / 1000)], "–");
  u:eval_report_row([name, to_string(row.attempted), to_string(row.tokens), u:eval_report_decimal(row.wall_ms / 1000), u:eval_report_decimal(row.mean_call_ms / 1000), bounds, to_string(row.truncated)])
}

summary = u:eval_author_summary(read_text("docs/results/book-author-v2-attempts.jsonl")?, read_text("docs/results/book-author-v2-methods.jsonl")?, parse_json(read_text("docs/results/book-author-v2-completion.json")?)?)?
write_atomic("docs/results/book-author-v2-summary.json", to_json(summary)?)?
print(to_json(summary)?)
if summary.complete {
  table = "| Method | Correct | Accuracy | Descriptive 95% Wilson interval |\n|--------+---------+----------+--------------------------------|\n";
  table = str_concat(table, u:eval_report_accuracy_row("Direct", summary.direct));
  table = str_concat(table, u:eval_report_accuracy_row("Greedy CoT", summary.cot));
  table = str_concat(table, u:eval_report_accuracy_row("Three-sample CoT vote", summary.voting));
  table = str_concat(table, "\n| Method | Calls | New tokens | Total decode seconds | Mean seconds/call | Call range, seconds | Capped calls |\n|--------+-------+------------+----------------------+-------------------+---------------------+--------------|\n");
  table = str_concat(table, u:eval_report_cost_row("Direct", summary.direct));
  table = str_concat(table, u:eval_report_cost_row("Greedy CoT", summary.cot));
  table = str_concat(table, u:eval_report_cost_row("Three-sample CoT vote", summary.voting));
  table = str_concat(table, "\n| Author position | Direct correct | CoT correct | Voted correct |\n|-----------------+----------------+-------------+---------------|\n");
  i = 0;
  while lt(i, 10) {
    table = str_concat(table, u:eval_report_row([to_string(i + 1), to_string(at(summary.direct.outcomes, i)), to_string(at(summary.cot.outcomes, i)), to_string(at(summary.voting.outcomes, i))]));
    i = i + 1
  };
  write_atomic("out/book-author-v2-tables.org", table)?
}
ok(1)
