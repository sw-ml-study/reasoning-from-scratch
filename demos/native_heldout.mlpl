# Frozen six-problem, two-seed paired native inference pilot. Raw downloaded questions and responses remain local; public records contain only measurement metadata. Run via scripts/run-native-reasoning pilot.
include "lib/text/text.mlpl";
include "lib/verify/number.mlpl";
include "lib/verify/expr.mlpl";
include "lib/verify/extract.mlpl";
include "lib/verify/normalize.mlpl";
include "lib/verify/grade.mlpl";
include "lib/eval/data.mlpl";
include "lib/eval/harness.mlpl";
include "lib/eval/paired.mlpl";
include "lib/backend/ollama.mlpl";

def u:eval_pilot_attempt(item, seed, think, stem) {
  "Save the reference-free request and raw response, grade only the final answer, and return public numeric accounting including failures.";
  body = u:backend_chat_body("qwen3:8b-q6", u:eval_render_prompt(item.problem), think, seed, 3072)?;
  write_atomic(str_concat(stem, "-request.json"), body)?;
  print("Attempt:", item.unique_id, "seed:", seed, "think:", think);
  started = clock_ms();
  reply = u:http_request(u:backend_http_request("http://127.0.0.1:11434/api/chat", body));
  wall_ms = clock_ms() - started;
  if str_eq(type_of(reply), "record") {
    write_atomic(str_concat(stem, "-response.json"), u:backend_body_text(reply))?
  };
  decoded = u:backend_decode(reply);
  if is_err(decoded) {
    result = {correct: 0, complete: 0, error: 1, parseable: 0, tokens: 0, wall_ms: wall_ms, done_reason: "transport_or_protocol_error"};
    write_atomic(str_concat(stem, "-error.json"), to_json({error: err_message(decoded)})?)?
  } else {
    answer = unwrap(decoded);
    candidate = u:verify_final_candidate(answer.content, "boxed_only");
    result = {correct: u:backend_grade(answer, item.answer), complete: answer.complete, error: 0, parseable: gt(str_len(candidate), 0), tokens: answer.eval_count, wall_ms: wall_ms, done_reason: answer.done_reason};
    write_atomic(str_concat(stem, "-private-grade.json"), to_json({reference: item.answer, candidate: candidate, content: answer.content})?)?
  };
  write_atomic(str_concat(stem, "-metrics.json"), to_json(result)?)?;
  print("Outcome:", to_json(result)?);
  result
}

namespace = load_extension(env("EXTENSION_LIBRARY")?)
if str_eq(type_of(namespace), "result") {
  err(namespace)?
}
out_dir = env("DEMO_OUT")?
dataset = u:eval_load_jsonl_text(read_text("data/math500/native-heldout-v1.jsonl")?, "native-heldout-v1", {})?
if dataset.count - 6 {
  err("pilot requires six frozen problems")?
}
pairs_path = str_concat(out_dir, "/pairs.jsonl")
i = 0
while lt(i, dataset.count) {
  item = u:eval_record(dataset, i)?;
  replicate = 0;
  while lt(replicate, 2) {
    seed = 42 + replicate;
    first_mode = mod(i + replicate, 2);
    prefix = str_concat(out_dir, str_concat("/case-", str_concat(to_string(i), str_concat("-seed", to_string(seed)))));
    first = u:eval_pilot_attempt(item, seed, first_mode, str_concat(prefix, str_concat("-think", to_string(first_mode))));
    second = u:eval_pilot_attempt(item, seed, 1 - first_mode, str_concat(prefix, str_concat("-think", to_string(1 - first_mode))));
    pair = {id: item.unique_id, index: i, seed: seed, first_mode: first_mode, off: if first_mode {
        second
      } else {
        first
      }, on: if first_mode {
        first
      } else {
        second
      }};
    u:eval_write_line(pairs_path, str_concat(to_json(pair)?, "\n"), eq(i + replicate, 0))?;
    replicate = replicate + 1
  };
  i = i + 1
}
rows = read_text(pairs_path)?
seed = 42
while lt(seed, 44) {
  summary = u:eval_paired_summary(rows, seed)?;
  write_atomic(str_concat(out_dir, str_concat("/summary-seed", str_concat(to_string(seed), ".json"))), to_json(summary)?)?;
  print("SUMMARY:", to_json(summary)?);
  seed = seed + 1
}
ok("24 attempts retained; this pretrained pilot is not project training")
