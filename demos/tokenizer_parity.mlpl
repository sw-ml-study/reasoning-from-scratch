# Strict opt-in tokenizer parity: public load plus boxed-handle native adapters pending core R13; fixture ids, real goldens, round trips and NFC all fail on mismatch.
include "lib/text/text.mlpl";
include "lib/tokenizer/parity.mlpl";

def u:parity_encode(box, text) {
  "Work around R13: opaque handles can cross a user-function boundary inside records, but not as bare arguments.";
  _hftok:encode(box.handle, text)
}

def u:parity_decode(box, ids) {
  "Decode nonempty ids through the native ABI; empty ids return empty text locally because the current boundary rejects an empty decode argument.";
  if tally(ids) { _hftok:decode(box.handle, ids) } else {
    ""
  }
}
namespace = load_extension(env("EXTENSION_LIBRARY")?)
if str_eq(type_of(namespace), "result") {
  err(namespace)?
}
root = env("REPO_ROOT")?
tiny = u:hftok_load(str_concat(root, "/fixtures/tokenizer/tiny-tokenizer.json"))
fixture = u:tok_parity(read_text("fixtures/tokenizer/tiny-expected.jsonl")?, call(:u:parity_encode, {handle: tiny}), call(:u:parity_decode, {handle: tiny}))?
_hftok:close(tiny)
print("fixture ids and round trips:", fixture.matched, "elapsed ms:", fixture.elapsed_ms)
if str_eq(env("TOKENIZER_MODE")?, "real") {
  real = u:hftok_load(env("TOKENIZER_PATH")?);
  report = u:tok_parity(read_text(env("TOKENIZER_GOLDENS")?)?, call(:u:parity_encode, {handle: real}), call(:u:parity_decode, {handle: real}))?;
  composed = _hftok:encode(real, "Café");
  decomposed = _hftok:encode(real, "Café");
  if equal(composed, decomposed) * str_eq(_hftok:decode(real, decomposed), "Café") {
    ok(1)
  } else {
    err("NFC acceptance failed")?
  };
  print("real ids and round trips:", report.matched, "elapsed ms:", report.elapsed_ms, "NFC: pass");
  _hftok:close(real)
} else {
  print("Fixture-only check: real vocabulary not tested.")
}
ok(1)
