# Probe: a typed byte buffer should decode to a numeric array in one call. Exits 0 when unpack exists and reproduces known bf16 values.
bytes = pack([128, 63, 128, 191, 0, 64, 0, 63, 0, 0, 72, 66], "u8")
view = reinterpret(bytes, "bf16")
print("unpack-bulk: reinterpret gives", type_of(view), "which has no length and no arithmetic")
decoded = try {
  ok(unpack(bytes, "bf16"))
} catch e {
  err(e.message)
}
if is_err(decoded) {
  print("  unpack:", err_message(decoded));
  print("  scalar reads work:", read_bf16_le(bytes, 0), read_bf16_le(bytes, 2), read_bf16_le(bytes, 10));
  decoded
} else {
  values = unwrap(decoded);
  print("  unpacked:", values);
  if equal(values, [1, -1, 2, 0.5, 0, 50]) {
    ok(values)
  } else {
    err("unpack returned unexpected values")
  }
}
