# Probe: transpose_axes is differentiable inside grad() (exit 0) or rejected (exit 1).
w = param[6]
w = [1, 2, 3, 4, 5, 6]
outcome = try {
  grad(reduce_add(transpose_axes(reshape(w, [2, 3]), [1, 0]) * [[1, 2], [3, 4], [5, 6]]), w)
} catch e {
  err(e.message)
}
print("grad-transpose-axes:", outcome)
outcome
