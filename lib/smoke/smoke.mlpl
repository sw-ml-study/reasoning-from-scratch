# Real-model smoke compatibility guard. Requires lib/qwen3/qwen3.mlpl; no downloads or model allocation occur in this module.

def u:smoke_config(document, context) {
  "Require the pinned base architecture, including non-shape semantics, and allocate only the requested bounded rotary context.";
  expected = parse_json("{\"model_type\":\"qwen3\",\"vocab_size\":151936,\"hidden_size\":1024,\"num_hidden_layers\":28,\"num_attention_heads\":16,\"num_key_value_heads\":8,\"head_dim\":128,\"intermediate_size\":3072,\"rms_norm_eps\":0.000001,\"rope_theta\":1000000,\"max_position_embeddings\":32768,\"tie_word_embeddings\":true,\"attention_bias\":false,\"use_sliding_window\":false,\"rope_scaling\":null,\"hidden_act\":\"silu\",\"torch_dtype\":\"bfloat16\",\"eos_token_id\":151643}")?;
  fields = record_keys(expected);
  i = 0;
  while lt(i, list_len(fields)) {
    field = list_get(fields, i)?;
    actual = record_get(document, field)?;
    wanted = record_get(expected, field)?;
    if str_eq(to_json(actual)?, to_json(wanted)?) {
      i = i + 1
    } else {
      err(str_concat("unsupported checkpoint config field: ", field))?
    }
  };
  if gt(context, 0) * eq(context, floor(context)) * lt(context, 32769) {
    c = u:qwen_config_06b();
    ok({vocab: c.vocab, emb: c.emb, layers: c.layers, heads: c.heads, kv_heads: c.kv_heads, head_dim: c.head_dim, hidden: c.hidden, rope_base: c.rope_base, eps: c.eps, context: context})
  } else {
    err("smoke context must be an integer from 1 through 32768")
  }
}
