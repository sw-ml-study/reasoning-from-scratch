# Byte-level BPE encoding: the byte-to-character map, pre-tokenization, and the merge loop. This is the readable reference the native extension is checked against, not the production path. Requires lib/text/text.mlpl and lib/tokenizer/import.mlpl included first.

def u:tok_printable_byte(b) {
  "1 when a byte maps to itself in the byte-level alphabet: the printable ASCII range and two Latin-1 ranges.";
  gt(b, 32) * lt(b, 127) + gt(b, 160) * lt(b, 173) + gt(b, 173) * lt(b, 256)
}

def u:tok_byte_codepoint(b) {
  "Code point that represents one byte in the byte-level alphabet. Printable bytes stand for themselves; every other byte is lifted above 255 in ascending order, which is what makes a space appear as the marker character rather than as whitespace.";
  if u:tok_printable_byte(b) {
    b
  } else {
    if lt(b, 33) {
      256 + b
    } else {
      if lt(b, 161) {
        256 + 33 + b - 127
      } else {
        323
      }
    }
  }
}

def u:tok_codepoint_string(cp) {
  "One code point as a string, encoded as UTF-8. Code points here never exceed 2047, so one or two bytes always suffice.";
  if lt(cp, 128) {
    decode_bytes([cp])
  } else {
    decode_bytes([192 + floor(cp / 64), 128 + mod(cp, 64)])
  }
}

def u:tok_byte_string(b) {
  "The single character standing for one byte.";
  u:tok_codepoint_string(u:tok_byte_codepoint(b))
}

def u:tok_symbol_separator() {
  "Separator used to hold a symbol list in one string. A newline is safe because the byte map lifts every control byte above 255, so no mapped character is ever a raw newline.";
  "\n"
}

def u:tok_map_text(text) {
  "Rewrite text into the byte-level alphabet, one character per input byte, joined by the symbol separator so the result is also the initial symbol list.";
  bytes = tokenize_bytes(text);
  count = tally(bytes);
  out = "";
  i = 0;
  while lt(i, count) {
    symbol = u:tok_byte_string(at(bytes, i));
    out = if i {
      str_concat(out, str_concat(u:tok_symbol_separator(), symbol))
    } else {
      symbol
    };
    i = i + 1
  };
  out
}

def u:tok_merge_base(tables, stride) {
  "Verify and return the offset between a merge's rank and the vocabulary id of the token it produces. Every merge is checked when stride is 1, otherwise every stride-th one. The encoder depends on this invariant: it uses the vocabulary id as the merge priority instead of building a rank table, which the language cannot construct cheaply for a list of this size.";
  count = u:tok_merge_count(tables);
  if count {
    first = u:tok_merge_joined(tables, 0);
    base_id = u:tok_token_id(tables, first);
    if is_err(base_id) {
      u:tok_error("invariant", "the first merge does not produce a vocabulary token")
    } else {
      base = unwrap(base_id);
      i = 0;
      failure = ok(base);
      while lt(i, count) {
        token = u:tok_merge_joined(tables, i);
        found = u:tok_token_id(tables, token);
        if is_err(found) {
          failure = u:tok_error("invariant", str_concat("merge produces no vocabulary token: ", token));
          i = count
        } else {
          if unwrap(found) - (base + i) {
            failure = u:tok_error("invariant", str_concat("merge rank and vocabulary id disagree at: ", token));
            i = count
          } else {
            i = i + stride
          }
        }
      };
      failure
    }
  } else {
    u:tok_error("invariant", "no merges")
  }
}

def u:tok_merge_joined(tables, index) {
  "The token one merge produces: its pair with the separating space removed.";
  pair = unwrap(list_get(tables.merges, index));
  at_space = str_find(pair, " ");
  str_concat(str_slice(pair, 0, at_space), str_slice(pair, at_space + 1, str_len(pair) - at_space - 1))
}

def u:tok_pair_priority(tables, left, right, base, count) {
  "Merge priority of an adjacent symbol pair: the vocabulary id of their concatenation when that token came from a merge, or -1 when the pair may not be merged. A lower value is a higher priority, which is exactly merge rank order.";
  joined = str_concat(left, right);
  found = record_get(tables.vocab, joined);
  if is_err(found) {
    0 - 1
  } else {
    id = unwrap(found);
    if lt(id, base) {
      0 - 1
    } else {
      if lt(id, base + count) {
        id
      } else {
        0 - 1
      }
    }
  }
}

def u:tok_merge_once(tables, symbols, base, count) {
  "Apply the single highest-priority merge available in a symbol list; returns the new list, or the list unchanged when nothing may be merged.";
  n = list_len(symbols);
  best = 0 - 1;
  best_at = 0 - 1;
  i = 0;
  while lt(i, n - 1) {
    priority = u:tok_pair_priority(tables, unwrap(list_get(symbols, i)), unwrap(list_get(symbols, i + 1)), base, count);
    if gt(priority, 0 - 1) {
      if lt(best, 0) + lt(priority, best) {
        best = priority;
        best_at = i
      } else {
        0
      }
    } else {
      0
    };
    i = i + 1
  };
  if lt(best_at, 0) {
    symbols
  } else {
    out = "";
    j = 0;
    while lt(j, n) {
      piece = if j - best_at {
        unwrap(list_get(symbols, j))
      } else {
        str_concat(unwrap(list_get(symbols, j)), unwrap(list_get(symbols, j + 1)))
      };
      out = if j {
        str_concat(out, str_concat(u:tok_symbol_separator(), piece))
      } else {
        piece
      };
      j = if j - best_at {
        j + 1
      } else {
        j + 2
      }
    };
    str_split(out, u:tok_symbol_separator())
  }
}

def u:tok_merge_all(tables, symbols, base, count) {
  "Merge repeatedly until no pair may be merged. Each pass removes one symbol, so the loop is bounded by the symbol count.";
  current = symbols;
  remaining = list_len(symbols);
  while gt(remaining, 1) {
    merged = u:tok_merge_once(tables, current, base, count);
    if list_len(merged) - list_len(current) {
      current = merged;
      remaining = list_len(merged)
    } else {
      remaining = 0
    }
  };
  current
}

def u:tok_symbol_ids(tables, symbols) {
  "Look up each symbol's vocabulary id; an unknown symbol is an error naming it.";
  n = list_len(symbols);
  ids = [];
  i = 0;
  failure = ok(1);
  while lt(i, n) {
    found = u:tok_token_id(tables, unwrap(list_get(symbols, i)));
    if is_err(found) {
      failure = found;
      i = n
    } else {
      ids = concat(ids, unwrap(found));
      i = i + 1
    }
  };
  if is_err(failure) {
    failure
  } else {
    ok(ids)
  }
}

def u:tok_encode_piece(tables, piece, base, count) {
  "Encode one pre-token: map its bytes into the byte-level alphabet, merge, then look up ids.";
  if str_eq(piece, "") {
    ok([])
  } else {
    symbols = str_split(u:tok_map_text(piece), u:tok_symbol_separator());
    u:tok_symbol_ids(tables, u:tok_merge_all(tables, symbols, base, count))
  }
}

def u:tok_is_word_byte(c) {
  "1 when a character is a letter or digit for pre-tokenization purposes. This is the documented approximation: the published pattern uses Unicode letter and number categories, and this reference recognizes only ASCII, so a word in a non-Latin script splits differently here than in the native tokenizer.";
  u:text_is_alnum(c)
}

def u:tok_is_newline(c) {
  "1 when a character is a carriage return or line feed.";
  str_eq(c, "\n") + str_eq(c, "\r")
}

def u:tok_space_end(text, i) {
  "Index just past the run of whitespace starting at i.";
  n = str_len(text);
  j = i;
  while lt(j, n) * u:text_is_space(u:text_char_at(text, j)) {
    j = j + 1
  };
  j
}

def u:tok_letters_end(text, i) {
  "Index just past the run of ASCII letters starting at i.";
  n = str_len(text);
  j = i;
  while lt(j, n) * u:text_is_letter(u:text_char_at(text, j)) {
    j = j + 1
  };
  j
}

def u:tok_contraction_end(text, i) {
  "End index of a contraction such as an apostrophe followed by s, t, m, d, re, ve, or ll, case-insensitively; -1 when none starts at i.";
  if str_eq(u:text_char_at(text, i), "'") {
    one = u:text_lower(u:text_char_at(text, i + 1));
    two = u:text_lower(str_slice(text, i + 1, 2));
    if str_eq(two, "re") + str_eq(two, "ve") + str_eq(two, "ll") {
      i + 3
    } else {
      if str_eq(one, "s") + str_eq(one, "t") + str_eq(one, "m") + str_eq(one, "d") {
        i + 2
      } else {
        0 - 1
      }
    }
  } else {
    0 - 1
  }
}

def u:tok_punctuation_end(text, i) {
  "End index of an optional leading space followed by a run of characters that are neither whitespace nor letters nor digits, then any newlines; -1 when none starts at i.";
  n = str_len(text);
  j = if str_eq(u:text_char_at(text, i), " ") {
    i + 1
  } else {
    i
  };
  start = j;
  while lt(j, n) * (1 - u:text_is_space(u:text_char_at(text, j))) * (1 - u:tok_is_word_byte(u:text_char_at(text, j))) {
    j = j + 1
  };
  if j - start {
    while lt(j, n) * u:tok_is_newline(u:text_char_at(text, j)) {
      j = j + 1
    };
    j
  } else {
    0 - 1
  }
}

def u:tok_newline_run_end(text, i) {
  "End index of a whitespace run that ends in a line break, measured to the last break in the run; -1 when the run contains none.";
  stop = u:tok_space_end(text, i);
  last = 0 - 1;
  j = i;
  while lt(j, stop) {
    if u:tok_is_newline(u:text_char_at(text, j)) {
      last = j
    } else {
      0
    };
    j = j + 1
  };
  if lt(last, 0) {
    0 - 1
  } else {
    last + 1
  }
}

def u:tok_trailing_space_end(text, i) {
  "End index of a whitespace run that is not followed by a visible character. A run followed by text gives its last character back to the word that follows, which is what puts one leading space on a word and leaves the rest as its own piece.";
  stop = u:tok_space_end(text, i);
  if stop - str_len(text) {
    if gt(stop - 1, i) {
      stop - 1
    } else {
      0 - 1
    }
  } else {
    if gt(stop, i) {
      stop
    } else {
      0 - 1
    }
  }
}

def u:tok_piece_end(text, i) {
  "End index of the pre-token starting at i, trying the published alternatives in their published order.";
  n = str_len(text);
  c = u:text_char_at(text, i);
  contraction = u:tok_contraction_end(text, i);
  if gt(contraction, 0 - 1) {
    contraction
  } else {
    lead = if u:tok_is_word_byte(c) + u:tok_is_newline(c) {
      i
    } else {
      i + 1
    };
    letters = u:tok_letters_end(text, lead);
    if gt(letters, lead) {
      letters
    } else {
      if u:text_is_digit(c) {
        i + 1
      } else {
        punctuation = u:tok_punctuation_end(text, i);
        if gt(punctuation, 0 - 1) {
          punctuation
        } else {
          newline_run = u:tok_newline_run_end(text, i);
          if gt(newline_run, 0 - 1) {
            newline_run
          } else {
            trailing = u:tok_trailing_space_end(text, i);
            if gt(trailing, 0 - 1) {
              trailing
            } else {
              if lt(i, n) {
                i + 1
              } else {
                0 - 1
              }
            }
          }
        }
      }
    }
  }
}

def u:tok_piece_bounds(text) {
  "Boundaries of every pre-token, as an array of start indexes ending with the length of the text. Boundaries rather than a list of strings, because a pre-token may itself contain a line break and no separator character is safe against the original text.";
  n = str_len(text);
  bounds = [0];
  i = 0;
  while lt(i, n) {
    stop = u:tok_piece_end(text, i);
    stop = if gt(stop, i) {
      stop
    } else {
      i + 1
    };
    bounds = concat(bounds, stop);
    i = stop
  };
  bounds
}

def u:tok_piece_count(bounds) {
  "Number of pre-tokens described by a boundary array.";
  tally(bounds) - 1
}

def u:tok_piece(text, bounds, index) {
  "One pre-token by index.";
  start = at(bounds, index);
  str_slice(text, start, at(bounds, index + 1) - start)
}

def u:tok_encode(tables, text, base, count) {
  "Encode text to token ids: pre-tokenize, then merge and look up each piece.";
  bounds = u:tok_piece_bounds(text);
  n = u:tok_piece_count(bounds);
  ids = [];
  i = 0;
  failure = ok(1);
  while lt(i, n) {
    piece_ids = u:tok_encode_piece(tables, u:tok_piece(text, bounds, i), base, count);
    if is_err(piece_ids) {
      failure = piece_ids;
      i = n
    } else {
      ids = concat(ids, unwrap(piece_ids));
      i = i + 1
    }
  };
  if is_err(failure) {
    failure
  } else {
    ok(ids)
  }
}
